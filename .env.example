# Neon database connection string (from Neon dashboard -> connection string)
DATABASE_URL="postgres://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require"

# Vercel Blob read/write token (from Vercel dashboard -> Storage -> Connect Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# Anthropic (Claude) -- probe-question generation + post-interview evaluation.
# Server-only, never sent to the client.
ANTHROPIC_API_KEY="sk-ant-..."
INTERVIEW_ANTHROPIC_MODEL="claude-sonnet-5"    # optional override

# OpenAI Realtime API -- live voice interview conduct. Server-only: the browser
# only ever receives a short-lived ephemeral client secret minted per session.
OPENAI_API_KEY="sk-..."
OPENAI_REALTIME_MODEL="gpt-realtime"           # optional override

# How long a candidate's interview link stays valid after creation.
INTERVIEW_LINK_TTL_DAYS="7"                    # optional override

# Google Gemini (Free tier fallback for grading and probe generation if Anthropic key is missing)
GEMINI_API_KEY="your_gemini_api_key_here"
