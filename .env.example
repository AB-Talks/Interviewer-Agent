# Neon database connection string (from Neon dashboard -> connection string)
DATABASE_URL="postgres://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require"

# Vercel Blob read/write token (from Vercel dashboard -> Storage -> Connect Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# OpenAI -- the only AI vendor this app uses. Server-only, never sent to the
# client. Two different OpenAI surfaces, one key:
#   - Realtime API: the live voice interview itself (browser only ever gets a
#     short-lived ephemeral client secret minted per session, never this key).
#   - Chat Completions: probe-question generation + post-interview evaluation
#     (lib/openai.ts, plain text-in/JSON-out calls, no voice involved).
OPENAI_API_KEY="sk-..."
OPENAI_REALTIME_MODEL="gpt-realtime"           # optional override
INTERVIEW_OPENAI_TEXT_MODEL="gpt-5-mini"       # optional override

# How long a candidate's interview link stays valid after creation.
INTERVIEW_LINK_TTL_DAYS="7"                    # optional override
